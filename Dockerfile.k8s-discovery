# rw-discovery-codecollection: the k8s-discovery capability image, not a
# Robot codebundle image.
#
# Image == capability, 1:1 (runwhen_capability/loader.py --
# discover_capability_dir's docstring). This repo ships exactly one
# capability, so unlike rw-checks-codecollection there is only one
# Dockerfile.
#
# It ships:
#   - the runwhen_capability SDK and its rwtask task host (the
#     runwhen-capability release pyproject.toml pins)
#   - rwdiscovery/, the Python core (chain, sanitize, rollups, pack, sync)
#   - the k8s-discovery capability's tasks (capabilities/k8s-discovery/)
#
# Dependencies are pinned by one of two mechanisms:
#   runwhen-capability (the SDK) -- pinned to a release tag, here and in
#     pyproject.toml. pip's --require-hashes mode does not support VCS
#     requirements at all, so this is installed in its OWN,
#     non-hash-checked `pip install` step, same as rw-checks-codecollection
#     installs its SDK layer unpinned by hash (`pip install /app`).
#   kubernetes, jmespath (the two runtime dependencies this capability talks
#     to the cluster and evaluates expressions through directly) -- pip-
#     compiled with hashes into requirements.txt (scripts/gen_pip_hashes.sh,
#     `uv pip compile --generate-hashes`), installed with
#     `pip install --require-hashes`, which refuses anything whose artifact
#     hash isn't listed and requires the full transitive closure pinned.
#
# No Go binary, no self-install init container: the runner
# (EXECUTOR-CONTRACT.md) dials `rwtask serve` as a warm executor over plain
# HTTP/JSON; `discover`/`inspect`/`connect` talk to the Kubernetes API and to
# papi over HTTP, never a subprocess. The one exception is `kubectl` itself
# (platform-contract §7's `cli` task) -- see the `kubectl` build stage below
# for how it's fetched and verified, and `rwdiscovery/cli.py` for the one
# place this image ever shells out to anything.
#
# Base image pinned by digest -- `python:3.12-slim`, resolved with
# `docker buildx imagetools inspect python:3.12-slim` on 2026-09-24. This is
# the multi-arch INDEX digest (covers both linux/amd64 and linux/arm64,
# which is what CI's build matrix builds), not a single-platform manifest
# digest -- pinning to one of those would break the other platform's build.
# Re-resolve and bump both FROM lines together when the base needs an update
# (a Renovate/Dependabot digest-update rule would keep this current
# automatically; none is wired up yet).
ARG BASE_IMAGE=python:3.12-slim@sha256:2f17fc044b579bab302c2e8054d3a686e2cb9a83de48e70534b94cd8ebbe06a9

# ---------------------------------------------------------------------------
# builder -- everything that needs `git` (only the SDK's VCS pip install
# does) or a C toolchain lives here. Nothing from this stage reaches the
# final image except the installed Python environment itself.
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ca-certificates: TLS for cloning the SDK's pinned release over HTTPS. git:
# build-time only, for pip to clone that release (see the runwhen-capability
# install step below) -- confined to this stage; see the final stage's
# header comment for why it must never reach the shipped image.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
        git \
    && rm -rf /var/lib/apt/lists/*

# An isolated venv, not the base image's system site-packages: the final
# stage copies this directory verbatim and nothing else, so what's installed
# here is exactly (and only) what ships.
RUN python3 -m venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"

# kubernetes + jmespath, hash-verified. --require-hashes also refuses to
# install anything not pinned here, so a transitive dependency cannot slip
# in unhashed.
COPY requirements.txt /build/requirements.txt
RUN pip install --no-cache-dir --require-hashes -r /build/requirements.txt \
    && rm -rf /build

# The SDK, at the release pyproject.toml pins -- see the header comment
# above for why this is a separate, non-hash-checked install step.
WORKDIR /app
COPY pyproject.toml README.md LICENSE /app/
COPY rwdiscovery /app/rwdiscovery
RUN pip install --no-cache-dir --no-deps /app \
    && pip install --no-cache-dir "runwhen-capability @ git+https://github.com/runwhen-contrib/runwhen-capability@v0.1.0"

# ---------------------------------------------------------------------------
# kubectl -- platform-contract §7's `cli` task execs the real binary; fetched
# here and sha256-verified against the digest dl.k8s.io itself publishes
# (https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/<arch>/kubectl.sha256),
# never trusted from a package-manager mirror. `TARGETARCH` is buildx's own
# automatic per-platform ARG (amd64/arm64 -- CI's build matrix), which is
# also all `curl`'s URL needs to pick the right binary; only the verified
# `/kubectl` file crosses into the final stage below, never this stage's own
# `curl`/apt state.
#
# v1.37.1, the latest stable release as of 2026-09-27
# (https://dl.k8s.io/release/stable.txt) -- bump KUBECTL_VERSION and both
# KUBECTL_SHA256_* args together; each is that version's own published
# per-arch digest, independently re-verified against the downloaded binary
# at pin time.
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS kubectl
ARG TARGETARCH
ARG KUBECTL_VERSION=v1.37.1
ARG KUBECTL_SHA256_AMD64=65691ff77eb6fa44c908b77a1082c9f092c3b9733b5cefabec0d1104890e21a8
ARG KUBECTL_SHA256_ARM64=ff749f4b78d9c4f1ec87307df9b50119ed819e2094aa9810cb9acffc3286c8c7

RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/* \
    && case "${TARGETARCH}" in \
           amd64) echo "${KUBECTL_SHA256_AMD64}  /kubectl" > /kubectl.sha256 ;; \
           arm64) echo "${KUBECTL_SHA256_ARM64}  /kubectl" > /kubectl.sha256 ;; \
           *) echo "unsupported TARGETARCH: ${TARGETARCH}" >&2; exit 1 ;; \
       esac \
    && curl -fsSL -o /kubectl "https://dl.k8s.io/release/${KUBECTL_VERSION}/bin/linux/${TARGETARCH}/kubectl" \
    && sha256sum -c /kubectl.sha256 \
    && chmod 0755 /kubectl

# ---------------------------------------------------------------------------
# final -- the shipped image. No git, no C toolchain, no build-time apt
# state: this capability never shells out to anything of its own choosing
# (it only ever talks to the Kubernetes API and papi over HTTP) except the
# one, sha256-pinned `kubectl` binary above, run only by the allow-listed
# `cli` task (`rwdiscovery/cli.py`) -- so a runtime git binary, or any other
# shell tool, would be pure attack surface, not a dependency, and none is
# here to find.
# ---------------------------------------------------------------------------
FROM ${BASE_IMAGE} AS final

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

# ca-certificates only: TLS for the Kubernetes API server and papi.
RUN apt-get update && apt-get install -y --no-install-recommends \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:${PATH}"
COPY --from=kubectl /kubectl /usr/local/bin/kubectl

WORKDIR /app
COPY capabilities/k8s-discovery /app/capabilities/k8s-discovery
COPY packs/kubernetes /app/packs/kubernetes
ENV RWDISCOVERY_PACK_PATH=/app/packs/kubernetes/pack.yaml

# --- OCI image annotations (opencontainers.org/image-spec) -------------------
# Standard keys registries and scanners read. REVISION/CREATED are build
# args because they are the only two values that cannot be known from the
# source tree alone; CI passes them.
#
# CAPABILITY_MANIFEST_B64 is the base64 of
# capabilities/k8s-discovery/manifest.yaml (`rwtask label
# capabilities/k8s-discovery`); CAPABILITY_SCHEMAS_B64 is the base64 of a
# JSON object holding every file under its schemas/, keyed
# "schemas/<filename>" (`rwtask label --schemas ...`). CI computes both at
# build time, so these labels can never drift from the files they
# describe, and the catalog reads the capability straight off the pushed
# image.
ARG REVISION=unknown
ARG CREATED=unknown
ARG CAPABILITY_MANIFEST_B64=""
ARG CAPABILITY_SCHEMAS_B64=""
LABEL org.opencontainers.image.title="k8s-discovery" \
      org.opencontainers.image.description="Kubernetes cluster discovery capability for the RunWhen platform" \
      org.opencontainers.image.source="https://github.com/runwhen-contrib/rw-discovery-codecollection" \
      org.opencontainers.image.licenses="Apache-2.0" \
      org.opencontainers.image.revision="${REVISION}" \
      org.opencontainers.image.created="${CREATED}" \
      io.runwhen.capability="k8s-discovery" \
      com.runwhen.capability.manifest.v1="${CAPABILITY_MANIFEST_B64}" \
      com.runwhen.capability.schemas.v1="${CAPABILITY_SCHEMAS_B64}"

# Non-root. /work is rwtask serve's default --workdir -- every request's
# scope directory (<workdir>/<scopeId>/) is created and wiped under it,
# including the request-scoped kubeconfig temp file (credentials.py, and
# cli.py's own copy for the `cli` task's kubectl subprocess), so it's the
# one directory this user needs to write. /usr/local/bin/kubectl above is
# 0755 -- world-readable and -executable, so this user can run it without
# owning it.
RUN useradd --create-home --uid 1000 --shell /usr/sbin/nologin runwhen \
    && mkdir -p /work \
    && chown -R runwhen:runwhen /work /app
USER runwhen

# rwtask's argv IS the container command -- no Robot runtime, nothing to
# reset. ENTRYPOINT [] is kept explicit so `docker run <image> <anything>`
# never surprises anyone who expects the rw-base-runtime convention from
# this org's other collections.
#
# --capability-dir is baked in explicitly rather than left to
# discover_capability_dir's default: this image's own argv must never rely
# on "there happens to be exactly one capabilities/*/manifest.yaml" being
# true -- that auto-discovery stays a local-dev convenience only (see
# `rwtask run`, README.md).
ENTRYPOINT []
CMD ["rwtask", "serve", "--capability-dir", "/app/capabilities/k8s-discovery"]
